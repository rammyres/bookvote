# Copie para .env e preencha antes de subir o container.

# Chave usada para assinar cookies e hashear IPs. Gere com:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
BOOKVOTE_SECRET_KEY=

# Cloudflare Turnstile (captcha gratuito). Se deixar em branco, o captcha
# fica desativado e a app roda (útil para testar localmente, não recomendado
# em produção). Crie as chaves em https://dash.cloudflare.com/ > Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Exige HTTPS para o cookie de identificação do votante (deixe "true" em produção).
BOOKVOTE_COOKIE_SECURE=true

# Quantas "identidades" de votante distintas uma mesma rede/IP pode criar por enquete.
BOOKVOTE_MAX_VOTERS_PER_IP=6

# Opcional: chave de API do Google Books (aumenta a cota de busca por IP).
# Sem essa chave a busca de livros (autocomplete na indicação) já funciona,
# só com uma cota pública mais baixa. Crie em https://console.cloud.google.com/
# (ative a "Books API" e gere uma API key).
GOOGLE_BOOKS_API_KEY=

# Opcional: chave de API do Resend (https://resend.com), usada para enviar
# o link de administração por e-mail ao criar a enquete e para o "esqueci
# o link" na página pública. Sem essa chave, essas duas funcionalidades
# simplesmente não enviam e-mail (o resto do app funciona normalmente).
RESEND_API_KEY=
# Remetente usado nos e-mails. No plano gratuito do Resend, sem domínio
# verificado, use o remetente de testes deles (só funciona enviando para o
# e-mail da própria conta Resend). Com um domínio verificado no Resend,
# troque para algo como "Enquete de Livros <enquete@seudominio.com.br>".
RESEND_FROM_EMAIL=Enquete de Livros <onboarding@resend.dev>

# Opcional: leitura automática da imagem do cronograma em /adminlc (preenche
# as semanas do cronograma detalhado; o admin revisa antes de salvar).
# Chave gratuita em https://aistudio.google.com/apikey — sem ela o botão
# simplesmente não aparece e o preenchimento manual segue igual.
GEMINI_API_KEY=
# Modelo com visão a usar (padrão: gemini-3.8-flash).
GEMINI_MODEL=
# Nível de raciocínio: low (padrão), medium ou high. Em modelos Gemini 3.x
# "minimal" não é aceito.
GEMINI_THINKING_LEVEL=
# Modelo de reserva usado se o principal falhar por alta demanda, timeout ou
# erro do servidor (padrão: gemini-2.5-flash; "none" desliga o fallback).
GEMINI_FALLBACK_MODEL=

# Armazenamento dos arquivos enviados (imagens, capas, material de apoio):
# local (padrão, volume do Docker), r2 (Cloudflare R2) ou gcs (Google Cloud
# Storage). Rode scripts/setup_env.sh para preencher interativamente.
STORAGE_BACKEND=local
# --- só para r2/gcs ---
STORAGE_BUCKET=
# "Pasta" dentro do bucket (opcional).
STORAGE_PREFIX=
# Opcional: URL pública do bucket/CDN. Vazio = o app serve /media (bucket privado ok).
STORAGE_PUBLIC_BASE_URL=
# Opcional: endpoint S3 customizado (padrão do R2/GCS é montado sozinho).
STORAGE_ENDPOINT_URL=
# Enquanto migra do disco: continua lendo do disco o que ainda não está no bucket.
STORAGE_LOCAL_FALLBACK=true
# r2:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# gcs (chaves HMAC de interoperabilidade):
GCS_HMAC_ACCESS_KEY=
GCS_HMAC_SECRET=
